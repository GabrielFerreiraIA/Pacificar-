# Copie para .env.local e preencha. Nunca commite o .env.local.
# Tabela completa em finalizacao/PLANO.md → "Variáveis de ambiente".

# --- Front-end (vão para o navegador: NUNCA coloque segredo em VITE_*) ---
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="chave-anon-publica"

# --- Só nas funções de api/ (Vercel). Não use prefixo VITE_ ---
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="chave-service-role-secreta"
KIWIFY_WEBHOOK_TOKEN="token-do-webhook-na-kiwify"
CRON_SECRET="uma-string-aleatoria-longa"
APP_URL="https://seu-dominio.vercel.app"

# --- Contato (público) ---
# WhatsApp da Ana, só dígitos com DDI e DDD. Ex.: 5547999998888
VITE_ANA_WHATSAPP=""

# --- Demo da Ana (T-85) ---
# "true" liga o botao de demonstracao (dados ficticios, salvos no navegador).
