# Copie para .env.local e preencha. Nunca commite o .env.local.
# Tabela completa em finalizacao/PLANO.md → "Variáveis de ambiente".

# --- Front-end (vão para o navegador: NUNCA coloque segredo em VITE_*) ---
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="chave-anon-publica"

# --- Só nas funções de api/ (Vercel). Não use prefixo VITE_ ---
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="chave-service-role-secreta"
# Eduzz (T-34): chave secreta do webhook, criada no Console da Eduzz (Webhook → Chave de acesso)
EDUZZ_WEBHOOK_SECRET="chave-secreta-do-webhook-eduzz"
# Opcional: ids dos produtos que liberam o app, separados por vírgula. Vazio = qualquer produto da conta.
EDUZZ_PRODUCT_IDS=""
CRON_SECRET="uma-string-aleatoria-longa"
APP_URL="https://seu-dominio.vercel.app"

# --- Contato (público) ---
# WhatsApp da Ana, só dígitos com DDI e DDD. Ex.: 5547999998888
VITE_ANA_WHATSAPP=""

# --- Demo (T-86) ---
# Não precisa de variável: na tela de login, toque 5 vezes no logo para abrir a demonstração.
# "true" só deixa o botão visível (útil em preview). Em produção, deixe vazio.
VITE_DEMO=""
